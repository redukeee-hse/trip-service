# --- ЛР1: сервер и база ----------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://tripgo:tripgo@localhost:5432/tripgo?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

HTTP_PING_TIMEOUT=1s

# --- ЛР2: OpenTelemetry ----------------------------------------------------
# Адрес коллектора печатает `tripgoctl connect` (OTel HTTP или OTel gRPC).
OTEL_SERVICE_NAME=trip-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# grpc или http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# always_on, always_off, traceidratio, parentbased_always_on,
# parentbased_always_off, parentbased_traceidratio
OTEL_TRACES_SAMPLER=parentbased_always_on
# доля трейсов для *traceidratio, от 0 до 1
OTEL_TRACES_SAMPLER_ARG=1
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tripgo,deployment.environment=local
# как часто отправлять метрики, мс (по умолчанию 60000)
OTEL_METRIC_EXPORT_INTERVAL=10000
